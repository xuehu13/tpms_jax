# Preserve original Abaqus records, including CRLF and diagnostic spacing.
validation/abaqus_element/*.sta -text whitespace=-blank-at-eol,-blank-at-eof
validation/abaqus_element/*.mtx -text whitespace=-blank-at-eol,-blank-at-eof
validation/abaqus_element/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
validation/abaqus_element/*.json -text whitespace=cr-at-eol
validation/abaqus_discrete/*.sta -text whitespace=-blank-at-eol,-blank-at-eof
validation/abaqus_discrete/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
validation/abaqus_discrete/*.json -text whitespace=cr-at-eol
