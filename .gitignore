# pixi 环境
.pixi/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# pytest 缓存
.pytest_cache/

# 本地临时文件与密钥
.env
.env.*
*.key
*.token
*.log

# 大型计算结果与可视化文件
results/
*.vtu
*.vtk
*.msh
*.npy
*.npz
!validation/abaqus_element/comparison.matrices.npz
!validation/abaqus_discrete/discrete_gyroid_N4_fixed.quadrature.npz
*.h5

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store

!validation/abaqus_binary/binary_uniform_C3D10_*.mesh.npz

# Local frozen evidence stays in place; publish one maintained implementation.
validation/**/source_*/
validation/**/*.dat
validation/**/*.msg
validation/**/*.sta
validation/**/*.prt
validation/**/*.com
validation/**/*.sim
validation/**/*.lck
# One-time review tools and old PDF exports are local archives.
docs/history/**/*.py
docs/history/**/*.pdf
validation/**/*.console.txt

# Repeated failed-attempt decks remain in the local frozen archive.
validation/thin_target_20261004_r5/step3_xyz/attempt*/thin_shell.inp

# Step 4 local execution protection and raw stopped-attempt files.
validation/.thin_step4_process.lock
validation/thin_target_20261004_r5/step4_thickness_a*/attempt*/thin_shell.inp
validation/**/thread_observation.txt

# This round keeps raw telemetry and repeated decks locally, with one canonical Explicit deck.
validation/large_compression_20261005_r6/**/*.resource.json
validation/large_compression_20261005_r6/**/jax.progress.json
validation/large_compression_20261005_r6/**/*.inp
!validation/large_compression_20261005_r6/abaqus/explicit_T0p020/thin_shell.inp
